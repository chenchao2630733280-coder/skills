{
  "_readme": "最小可用 campaign 模板：改 levels / phases / segments 三块即可跑通。字段说明见 references/09_automation_pipeline.md，示例见 examples/campaign_demo.json。",

  "campaign_id": "my_saga_ch01",
  "genre": "match3",
  "version": "0.1.0",
  "data_source": "未接入真实数据（纯模型预测）",

  "mapping": {"spread": 4.0, "ref_segment": "regular"},

  "segments": {
    "novice":  {"theta": -0.9, "theta_sd": 0.45, "target_first_try": 0.68},
    "regular": {"theta": 0.0,  "theta_sd": 0.50, "target_first_try": 0.52},
    "skilled": {"theta": 0.95, "theta_sd": 0.45, "target_first_try": 0.38}
  },

  "feature_model": {
    "resource_pressure":  {"kind": "ratio",  "num": "target_amount", "den": "moves", "lo": 70, "hi": 280},
    "mechanic_load":      {"kind": "linear", "param": "obstacle_kinds", "lo": 0, "hi": 4},
    "strategy_depth":     {"kind": "linear", "param": "objective_kinds", "lo": 1, "hi": 4},
    "randomness":         {"kind": "linear", "param": "colors", "lo": 4, "hi": 7}
  },

  "legal_ranges": {
    "moves": [16, 30],
    "target_amount": [1200, 7000],
    "obstacle_kinds": [0, 4],
    "objective_kinds": [1, 4],
    "colors": [4, 7]
  },

  "thresholds": {
    "jump_winrate": 0.10,
    "band_tolerance": 0.05,
    "min_sample": 30
  },

  "simulation": {
    "players_per_segment": 400,
    "batches": 8,
    "max_attempts": 5,
    "retry_prob": 0.55,
    "seed_jitter_k": 0.55
  },

  "phases": [
    {"name": "教学", "from_index": 1, "to_index": 3, "shape": "ramp", "start_win": 0.86, "end_win": 0.80, "mechanics_intro": ["基础交换"]},
    {"name": "练习", "from_index": 4, "to_index": 6, "shape": "ramp", "start_win": 0.78, "end_win": 0.68, "mechanics_intro": ["木箱"]}
  ],

  "levels": [
    {"level_id": "L01", "index": 1, "tag": "TUTORIAL", "params": {"moves": 26, "target_amount": 1600, "obstacle_kinds": 0, "objective_kinds": 1, "colors": 5}, "features": {"goal_complexity": 0.10}, "new_mechanics": ["基础交换"], "notes": ""},
    {"level_id": "L02", "index": 2, "tag": "TUTORIAL", "params": {"moves": 25, "target_amount": 1900, "obstacle_kinds": 0, "objective_kinds": 1, "colors": 5}, "features": {"goal_complexity": 0.14}, "new_mechanics": []},
    {"level_id": "L03", "index": 3, "tag": "TUTORIAL", "params": {"moves": 24, "target_amount": 2100, "obstacle_kinds": 1, "objective_kinds": 1, "colors": 5}, "features": {"goal_complexity": 0.18}, "new_mechanics": []},
    {"level_id": "L04", "index": 4, "tag": "PRACTICE", "params": {"moves": 23, "target_amount": 2400, "obstacle_kinds": 1, "objective_kinds": 2, "colors": 5}, "features": {"goal_complexity": 0.24}, "new_mechanics": ["木箱"]},
    {"level_id": "L05", "index": 5, "tag": "PRACTICE", "params": {"moves": 22, "target_amount": 2600, "obstacle_kinds": 1, "objective_kinds": 2, "colors": 5}, "features": {"goal_complexity": 0.28}, "new_mechanics": []},
    {"level_id": "L06", "index": 6, "tag": "PRACTICE", "params": {"moves": 21, "target_amount": 2900, "obstacle_kinds": 2, "objective_kinds": 2, "colors": 6}, "features": {"goal_complexity": 0.32}, "new_mechanics": []}
  ]
}
