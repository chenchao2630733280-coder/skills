{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Short Drama Topic Output v2.1",
  "type": "object",
  "required": [
    "generation_strategy",
    "trend_radar",
    "topics",
    "variable_distribution",
    "recommendations"
  ],
  "properties": {
    "generation_strategy": {
      "type": "object",
      "properties": {
        "historical_biases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoided_biases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variable_quotas": {
          "type": "object"
        },
        "creative_coordinate_distribution": {
          "type": "object"
        },
        "observation_date": {
          "type": "string"
        }
      }
    },
    "trend_radar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "level",
          "observation_date",
          "signal_summary",
          "confidence",
          "story_translation"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "enum": [
              "confirmed",
              "seasonal",
              "emerging",
              "weak_signal"
            ]
          },
          "region": {
            "type": "string"
          },
          "observation_date": {
            "type": "string"
          },
          "source_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signal_summary": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "expected_window": {
            "type": "string"
          },
          "social_emotion": {
            "type": "string"
          },
          "story_translation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overheat_risk": {
            "type": "string"
          },
          "expiry_risk": {
            "type": "string"
          },
          "sensitivity_risk": {
            "type": "string"
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "logline",
          "genre",
          "innovation_level",
          "creative_coordinates",
          "protagonist",
          "protagonist_goal",
          "core_rule",
          "rule_cost",
          "core_relationship",
          "viewing_motivation",
          "trend_binding",
          "history_similarity",
          "scores"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "logline": {
            "type": "string"
          },
          "genre": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "innovation_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "creative_coordinates": {
            "type": "object"
          },
          "protagonist": {
            "type": "string"
          },
          "protagonist_goal": {
            "type": "string"
          },
          "core_rule": {
            "type": "string"
          },
          "rule_cost": {
            "type": "string"
          },
          "core_relationship": {
            "type": "string"
          },
          "viewing_motivation": {
            "type": "object",
            "required": [
              "primary",
              "secondary",
              "long_term_payoff",
              "midpoint_shift",
              "episode_1_question",
              "episode_1_reward",
              "episode_3_payoff",
              "episode_10_payoff",
              "new_question_after_payoff",
              "midpoint_new_question",
              "final_waiting_result"
            ],
            "properties": {
              "primary": {
                "type": "string"
              },
              "secondary": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "long_term_payoff": {
                "type": "string"
              },
              "midpoint_shift": {
                "type": "string"
              },
              "episode_1_question": {
                "type": "string"
              },
              "episode_1_reward": {
                "type": "string"
              },
              "episode_3_payoff": {
                "type": "string"
              },
              "episode_10_payoff": {
                "type": "string"
              },
              "new_question_after_payoff": {
                "type": "string"
              },
              "midpoint_new_question": {
                "type": "string"
              },
              "final_waiting_result": {
                "type": "string"
              }
            }
          },
          "trend_binding": {
            "type": "object",
            "properties": {
              "trend_name": {
                "type": "string"
              },
              "trend_level": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              },
              "translation": {
                "type": "string"
              },
              "development_window": {
                "type": "string"
              },
              "release_window": {
                "type": "string"
              },
              "works_without_trend": {
                "type": "boolean"
              }
            }
          },
          "history_similarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "difference_from_history": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "six_stage_continuity": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "string"
            }
          },
          "weakest_link": {
            "type": "string"
          },
          "optimization": {
            "type": "string"
          },
          "production_difficulty": {
            "type": "string"
          },
          "compliance_risk": {
            "type": "string"
          },
          "scores": {
            "type": "object",
            "required": [
              "viewing_motivation",
              "diversity",
              "trend",
              "total"
            ],
            "properties": {
              "viewing_motivation": {
                "type": "number"
              },
              "diversity": {
                "type": "number"
              },
              "trend": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "variable_distribution": {
      "type": "object"
    },
    "comparison": {
      "type": "array"
    },
    "recommendations": {
      "type": "object"
    }
  }
}